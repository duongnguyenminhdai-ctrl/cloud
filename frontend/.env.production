# Toàn bộ request đi qua Vercel Reverse Proxy qua đường dẫn tương đối /api/v1
VITE_API_BASE_URL=/api/v1

# Để trống để Vercel vercel.json định tuyến tự động về 5 dịch vụ Render
VITE_AUTH_SERVICE_URL=
VITE_RESTAURANT_SERVICE_URL=
VITE_ORDER_SERVICE_URL=
VITE_PAYMENT_SERVICE_URL=
VITE_DELIVERY_SERVICE_URL=
