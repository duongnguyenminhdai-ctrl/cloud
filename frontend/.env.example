# ==============================================================================
# FRONTEND ENVIRONMENT TEMPLATE (VERCEL REVERSE PROXY & API GATEWAY)
# ==============================================================================
# 1. Cấu hình Vercel Reverse Proxy / API Gateway (Khuyến nghị cho Production)
# Sử dụng đường dẫn tương đối để che giấu 5 domain backend Render và tránh lỗi CORS:
VITE_API_BASE_URL=/api/v1

# 2. Các biến URL trực tiếp đến từng dịch vụ Render (Để trống khi dùng Vercel Reverse Proxy)
# Chỉ điền nếu bạn muốn client gọi trực tiếp đến từng microservice độc lập (yêu cầu cấu hình CORS trên backend)
VITE_AUTH_SERVICE_URL=
VITE_RESTAURANT_SERVICE_URL=
VITE_ORDER_SERVICE_URL=
VITE_PAYMENT_SERVICE_URL=
VITE_DELIVERY_SERVICE_URL=

# 3. Firebase Phone Authentication (SMS OTP chống SĐT rác)
# Lấy từ Firebase Console -> Project Settings -> Your apps (Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
