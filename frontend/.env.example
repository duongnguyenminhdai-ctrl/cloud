# ==============================================================================
# FRONTEND ENVIRONMENT TEMPLATE (VERCEL & LOCAL)
# ==============================================================================

# Cách 1: Sử dụng qua API Gateway duy nhất (mặc định local)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Cách 2: Triển khai Microservices độc lập trên Render (dành cho Vercel)
# Điền các URL Web Service do Render cấp cho từng service
VITE_AUTH_SERVICE_URL=https://auth-service.onrender.com/api/v1
VITE_RESTAURANT_SERVICE_URL=https://restaurant-service.onrender.com/api/v1
VITE_ORDER_SERVICE_URL=https://order-service.onrender.com/api/v1
VITE_PAYMENT_SERVICE_URL=https://payment-service.onrender.com/api/v1
VITE_DELIVERY_SERVICE_URL=https://delivery-service.onrender.com/api/v1
