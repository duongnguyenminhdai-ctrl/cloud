# ==============================================================================
# FOODFAST MICROSERVICES - ENVIRONMENT TEMPLATE
# Sao chép file này thành .env và điền các giá trị thực tế của bạn
# ==============================================================================

# 1. MongoDB Atlas Databases
MONGO_URI_AUTH=mongodb+srv://<username>:<password>@cluster1.xxxxxx.mongodb.net/auth_db?retryWrites=true&w=majority
MONGO_URI_RESTAURANT=mongodb+srv://<username>:<password>@cluster1.xxxxxx.mongodb.net/restaurant_db?retryWrites=true&w=majority
MONGO_URI_ORDER=mongodb+srv://<username>:<password>@cluster1.xxxxxx.mongodb.net/order_db?retryWrites=true&w=majority
MONGO_URI_PAYMENT=mongodb+srv://<username>:<password>@cluster1.xxxxxx.mongodb.net/payment_db?retryWrites=true&w=majority
MONGO_URI_DELIVERY=mongodb+srv://<username>:<password>@cluster1.xxxxxx.mongodb.net/delivery_db?retryWrites=true&w=majority

# 2. JWT Secret
JWT_SECRET=super_secret_jwt_key_123

# 3. Cache & Message Broker (Hỗ trợ Local & Cloud: CloudAMQP / Upstash Redis)
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# 4. VNPay Sandbox Configuration
VNP_TMN_CODE=your_vnp_tmn_code
VNP_HASH_SECRET=your_vnp_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay-return

# 5. Email OTP (Gmail SMTP Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASS=your_16_digit_app_password
EMAIL_APP_PASSWORD=your_16_digit_app_password

# 6. Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:8080

# 7. Delivery Simulation Toggle
ENABLE_DELIVERY_SIMULATION=true

